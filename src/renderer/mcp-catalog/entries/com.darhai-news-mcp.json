{
  "$schema": "../schema/entry.schema.json",
  "name": "com.darhai/news-mcp",
  "title": "News & RSS",
  "description": "Mongolian headlines the moment you install it, plus any RSS or Atom feed and Hacker News. No API key, ever.",
  "version": "1.0.0",
  "websiteUrl": "https://github.com/sergei10a-rgb/darhai",
  "repository": { "url": "https://github.com/sergei10a-rgb/darhai", "source": "github" },
  "packages": [
    {
      "registryType": "binary",
      "identifier": "builtin-mcp-news.js",
      "version": "1.0.0",
      "runtimeHint": "native",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "DARHAI_NEWS_FEEDS",
          "description": "Optional. Your own feed URLs, comma- or newline-separated. Added to the curated Mongolian feeds - it never replaces them.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "x-wayland": {
    "tier": "core",
    "categories": ["search", "news", "research"],
    "tags": ["news", "rss", "atom", "mongolia", "hacker-news"],
    "maintainerType": "wayland",
    "license": "Apache-2.0",
    "verifiedAt": "2026-08-01",
    "popularityRank": 12,
    "installRate": 0.28,
    "iconUrl": "icons/news.svg",
    "brand": { "logoBackground": "linear-gradient(135deg,#ff6b35 0%,#1a1a1a 100%)", "logoForeground": "#ffffff" },
    "auth": { "method": "none" },
    "toolGroups": [
      { "label": "Mongolian news", "count": 3 },
      { "label": "Any RSS / Atom feed", "count": 1 },
      { "label": "Hacker News", "count": 1 }
    ],
    "setupGuide": { "path": "guides/com.darhai-news-mcp.md", "estimatedMinutes": 1, "stepCount": 2 },
    "platforms": ["macos", "windows", "linux"],
    "minWaylandVersion": "0.8.0"
  }
}
