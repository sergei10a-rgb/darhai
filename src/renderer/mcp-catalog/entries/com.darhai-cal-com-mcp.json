{
  "$schema": "../schema/entry.schema.json",
  "name": "com.darhai/cal-com-mcp",
  "title": "Cal.com Scheduling (read-only)",
  "description": "See your Cal.com bookings, event types and free slots, and let the assistant draft a booking for you to confirm. It never books, cancels or reschedules on its own.",
  "version": "1.0.0",
  "websiteUrl": "https://github.com/sergei10a-rgb/darhai",
  "repository": { "url": "https://github.com/sergei10a-rgb/darhai", "source": "github" },
  "packages": [
    {
      "registryType": "binary",
      "identifier": "builtin-mcp-cal-com.js",
      "version": "1.0.0",
      "runtimeHint": "native",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "CALCOM_API_KEY",
          "description": "API key from Cal.com -> Settings -> Developer -> API keys. Stays on this machine and is never shown to the model.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "CALCOM_BASE_URL",
          "description": "Only for self-hosted Cal.com. Leave blank for cal.com. A bare host such as cal.example.com is accepted - /v2 is appended for you.",
          "isRequired": false,
          "default": "https://api.cal.com/v2"
        }
      ]
    }
  ],
  "x-wayland": {
    "tier": "worker",
    "categories": ["calendar", "productivity"],
    "tags": ["cal-com", "scheduling", "read-only", "open-source"],
    "maintainerType": "wayland",
    "license": "Apache-2.0",
    "verifiedAt": "2026-08-01",
    "popularityRank": 25,
    "installRate": 0.16,
    "iconUrl": "icons/cal-com.svg",
    "brand": { "logoBackground": "linear-gradient(135deg,#ff6b35 0%,#1a1a1a 100%)", "logoForeground": "#ffffff" },
    "auth": {
      "method": "api-key",
      "providerName": "Cal.com",
      "providerSignupUrl": "https://app.cal.com/settings/developer/api-keys"
    },
    "toolGroups": [
      { "label": "Bookings", "count": 2 },
      { "label": "Event types & availability", "count": 2 },
      { "label": "Draft a booking to confirm", "count": 1 }
    ],
    "setupGuide": { "path": "guides/com.darhai-cal-com-mcp.md", "estimatedMinutes": 2, "stepCount": 2 },
    "platforms": ["macos", "windows", "linux"],
    "minWaylandVersion": "0.8.0"
  }
}
